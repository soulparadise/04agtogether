{
  "name": "04agtogether",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "node --watch --watch-preserve-output scripts/dev.mjs",
    "dev:lan": "node --watch --watch-preserve-output scripts/dev.mjs --lan",
    "dev:frontend": "vite frontend",
    "dev:backend": "node --watch --watch-preserve-output backend/dev.cjs",
    "test:dev": "node --test test/dev.test.mjs",
    "test:video": "node scripts/create-test-video.mjs",
    "test:network": "node scripts/network-benchmark.mjs",
    "build": "node scripts/build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:production": "node scripts/build-extension.mjs --production",
    "package:release": "node scripts/package-release.mjs",
    "prepare:beget": "node scripts/prepare-site-config.mjs",
    "dev:extension-site": "node scripts/extension-test-site.mjs",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "start": "node release/backend/app.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": { "esbuild": "^0.25.0", "vite": "^7.1.0" }
}
